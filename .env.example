# Copia questo file in .env.local (o .env) e inserisci i valori del progetto Supabase.
# .env e .env.local sono esclusi dal repository (.gitignore); questo file no, perché contiene
# solo valori finti. Il repository è pubblico: mai valori veri qui.
# Solo la chiave publishable: la service_role non va mai nel front end.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx
